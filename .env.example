# ─── Solana Degen Pipeline — environment template ──────────
# Copy this file to `.env` (or export the variables in your shell / systemd unit)
# and fill in real values. NEVER commit the real .env.

# Wallet private key in base58 (Phantom-compatible export format).
# If unset, the bot falls back to reading `bot_wallet.key` from the project root.
# Leave EMPTY if you prefer the file-based wallet — the bot handles both.
#
# To generate a fresh throwaway wallet for testing:
#   python -c "from solders.keypair import Keypair; import base58; kp=Keypair(); \
#     print('Public:', kp.pubkey()); print('Private:', base58.b58encode(bytes(kp)).decode())"
SOL_PRIVATE_KEY=

# Solana RPC endpoint. The free public mainnet RPC is rate-limited and slow;
# a paid Helius / QuickNode / Triton endpoint is strongly recommended for live trading.
# Default if unset: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
